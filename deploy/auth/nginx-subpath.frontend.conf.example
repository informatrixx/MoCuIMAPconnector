# Insert ONLY these locations in the existing HTTPS server block, after adapting
# the hostname. Retain its PHP/root routes and existing certificate configuration.
# The inner Compose proxy listens exclusively on 127.0.0.1:8443.
location /imap/ {
    access_log off;
    error_log /dev/null;
    client_max_body_size 64k;
    proxy_pass https://127.0.0.1:8443;
    proxy_ssl_server_name on;
    proxy_ssl_name admin.example.at;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host admin.example.at;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_intercept_errors off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# RFC 9728 places the endpoint path after this well-known prefix.
location = /.well-known/oauth-protected-resource/imap/mcp {
    access_log off;
    error_log /dev/null;
    proxy_pass https://127.0.0.1:8443;
    proxy_ssl_server_name on;
    proxy_ssl_name admin.example.at;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host admin.example.at;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_cache off;
    proxy_intercept_errors off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
}
