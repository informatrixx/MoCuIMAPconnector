# Process environment; lists must use JSON.
DATABASE_PATH=/var/lib/mocu-imap-mcp/mocu-imap.sqlite3
MOCU_MASTER_KEY_FILE=/etc/mocu-imap-mcp/master.key
MCP_BIND=127.0.0.1
MCP_PORT=8765
PUBLIC_BASE_URL=https://imap-mcp.example.at
ACCESS_MODE=local
TRUSTED_PROXY_IPS=[]
MCP_ALLOWED_HOSTS=["127.0.0.1","127.0.0.1:*","imap-mcp.example.at"]
MAX_ATTACHMENT_SIZE_MB=25
MAX_MESSAGE_SIZE_MB=50
MAX_BODY_CHARS=200000
SEARCH_SCAN_BUDGET=500
SEARCH_TIME_BUDGET=45
# Compose also needs MOCU_MASTER_KEY_HOST_FILE (absolute path outside checkout).
# Never put IMAP credentials or master key values here.
