# External operator file; replace placeholders before running prepare_auth/preflight.
PUBLIC_BASE_URL=https://admin.example.at/imap
MCP_HOST=admin.example.at
AUTH_HOST=admin.example.at
OIDC_BASE_URL=https://admin.example.at/imap/oidc
OIDC_ISSUER=https://admin.example.at/imap/oidc/realms/mocu
CHATGPT_REDIRECT_URI=https://replace-with-exact-redirect-from-connection.example/callback
ALLOWED_SUBJECTS=["REPLACE_WITH_IMMUTABLE_SUBJECT"]
ADMIN_SUBJECTS=["REPLACE_WITH_IMMUTABLE_SUBJECT"]
AUTH_CONFIG_DIR=/etc/mocu-auth/config
AUTH_SECRETS_DIR=/etc/mocu-auth/secrets
AUTH_TLS_DIR=/etc/mocu-auth/tls
AUTH_CA_FILE=/etc/ssl/certs/ca-certificates.crt
AUTH_SUBNET=172.29.187.0/24
AUTH_DYNAMIC_RANGE=172.29.187.128/25
AUTH_PROXY_IP=172.29.187.2
AUTH_LISTEN_IP=127.0.0.1
AUTH_HTTPS_PORT=8443
