# The full configured Keycloak hostname includes this public prefix.
location @OIDC_PATH@/ {
    # Browser assets and OIDC requests must not consume the MCP request budget.
    limit_req zone=provider burst=100 nodelay;
    proxy_pass http://keycloak:8080/;
    proxy_set_header Host @AUTH_HOST@;
    proxy_set_header X-Forwarded-Host @AUTH_HOST@;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $remote_addr;
}
location @OIDC_PATH@/admin/ { return 403; }
location @OIDC_PATH@/realms/master/ { return 403; }
location ~ ^@OIDC_PATH@/.*clients-registrations/ { return 403; }
