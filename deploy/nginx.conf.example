server {
    listen 443 ssl http2;
    server_name imap-mcp.example.at;

    ssl_certificate /etc/letsencrypt/live/imap-mcp.example.at/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/imap-mcp.example.at/privkey.pem;

    # optional reverse-proxy auth to avoid public anonymous access
    # auth_basic "Protected MCP";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    # Streamable-HTTP request sizing and timeout for MCP streaming
    client_max_body_size 4m;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    # simple rate limiting
    limit_req_zone $binary_remote_addr zone=mcp_api:10m rate=10r/s;
    limit_req zone=mcp_api burst=20 nodelay;

    location /mcp {
        proxy_pass http://127.0.0.1:8765/mcp;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
